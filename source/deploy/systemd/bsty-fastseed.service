[Unit]
Description=BSTY FastSeed DNS Seeder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fastseed
Group=fastseed
ExecStart=/usr/local/bin/bsty-fastseed run --config /etc/bsty-fastseed/fastseed.toml
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/bsty-fastseed /var/log/bsty-fastseed
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
